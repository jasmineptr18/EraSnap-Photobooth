      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1030,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x = $input.first().json; const provided = x.headers?.['x-fotobox-secret']; if (!provided || provided !== $env.N8N_SHARED_SECRET) throw new Error('Unauthorized webhook'); const orderId = x.body?.orderId; if (!/^JSM-[A-F0-9]{16}$/.test(orderId||'')) throw new Error('Invalid order ID'); return [{json:{orderId}}];"
      }
    },
