# Copy to .env, use unique long random values for secrets before exposing any service.
APP_ENV=development
PORT=4000
BASE_URL=http://localhost:4000
# For a split Vercel frontend + API deployment, set this to the exact Vercel site origin.
CORS_ORIGIN=
DATABASE_URL=postgres://jasmine:jasmine_dev_password@db:5432/fotobox
POSTGRES_DB=fotobox
POSTGRES_USER=jasmine
POSTGRES_PASSWORD=jasmine_dev_password
SESSION_SECRET=replace-with-random-64-characters
INTERNAL_API_KEY=replace-with-random-64-characters
N8N_SHARED_SECRET=replace-with-random-64-characters
N8N_DELIVERY_WEBHOOK=http://n8n:5678/webhook/era-snap-delivery
N8N_LEADS_WEBHOOK=http://n8n:5678/webhook/era-snap-lead
STORAGE_DIR=/app/storage
# demo ONLY local; use midtrans for real checkout
PAYMENT_MODE=demo
ALLOW_DEMO_PAYMENT=true
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Run Hermes Agent on your host; expose API safely to Docker via host.docker.internal
HERMES_API_URL=http://host.docker.internal:8642/v1/chat/completions
HERMES_API_KEY=
# Optional OpenClaw (host gateway), configure hooks separately
OPENCLAW_HOOK_URL=http://host.docker.internal:18789/hooks/agent
OPENCLAW_HOOK_TOKEN=
ADMIN_KEY=replace-with-random-admin-key
N8N_ENCRYPTION_KEY=replace-with-random-n8n-64-characters
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GOOGLE_SHEET_ID=SET_GOOGLE_SHEET_ID
TELEGRAM_CS_CHAT_ID=SET_TELEGRAM_CHAT_ID
CS_EMAIL=cs@example.com
